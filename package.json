{
  "name": "pandeiro-apps-experimentais",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "android:build": "expo run:android",
    "ios:build": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "import:rhythms": "node tools/import-rhythms.cjs",
    "build:kit": "tsx tools/build-kit.ts",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform ios --platform android",
    "preview": "node tools/preview.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.0",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@siteed/audio-studio": "3.2.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.0",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-linear-gradient": "~15.0.0",
    "expo-modules-core": "~3.0.30",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0"
  }
}
